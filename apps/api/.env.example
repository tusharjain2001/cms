# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=4000

# MongoDB Atlas connection string (the free M0 tier is plenty — content is text).
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/pagecraft

# Long random strings. Generate with: node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh

# How long a signed-in session lasts.
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# Where the dashboard is served from, for CORS. Comma-separated for several.
ADMIN_ORIGIN=http://localhost:3000

# Where the dashboard lives, used to build the links inside emails. Usually the
# same as ADMIN_ORIGIN, but only ever one address.
APP_URL=http://localhost:3000

# Email — required for people to sign up, because confirming an address is what
# makes an account usable. Without it the CMS still runs and everything else
# works; signing up refuses and says why, and outside production the link that
# would have been emailed is printed to this server's log instead.
#
# Any ordinary mailbox works. Zoho Mail's free plan on your own domain is the
# tidiest option; Gmail needs an App Password (not your normal password) and
# has low daily limits. Use port 465 with SMTP_SECURE=true, or 587 for STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
MAIL_FROM=Pagecraft <no-reply@yourdomain.com>

# Seed script: creates the platform administrator — you. This is the only
# account that skips email confirmation and the only one that can see across
# every user's websites. Everyone else signs up through the dashboard.
SEED_EMAIL=you@example.com
SEED_PASSWORD=change-me-now
SEED_NAME=Your Name

# Cloudflare R2 (media) — optional. Without these the CMS runs fine but photo
# uploads are disabled and the dashboard says so. R2 is S3-compatible: create a
# bucket + an R2 API token (Access Key ID + Secret), and attach a Custom Domain
# (cdn.<yourdomain>) fronted by Cloudflare Image Transformations for delivery.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# The R2 Custom Domain — NOT the un-cached r2.dev host.
R2_PUBLIC_BASE_URL=https://cdn.yourdomain.com
# Optional: HMAC secret for signed private-media URLs (validated by a CF Worker).
R2_URL_SIGNING_KEY=

# ------------------------------------------------------------ Dodo Payments
# Payments. Optional in the same way R2 and SMTP are: without these the CMS
# runs normally, the billing screen explains what is missing, and everyone
# still gets the free single-page website — they just cannot buy more.
#
# WHY DODO AND NOT RAZORPAY. The product is priced in USD, and Razorpay cannot
# bill USD recurring: its rails are RBI e-mandates, which may only be
# registered in INR, so creating a USD plan is refused outright. Dodo is a
# merchant of record — it is the legal seller, bills USD worldwide, handles the
# sales tax and settles to an Indian bank.
#
# THE LADDER IS A QUANTITY, NOT A SET OF TIERS. Create ONE subscription product
# for "one website, monthly" and ONE for "one website, yearly", priced at
# whatever packages/shared/src/plans.ts currently sets, with quantity/seat-based
# billing enabled and NO trial period (the free tier is enforced in our own
# code, and a provider trial would grant paid access this API knows nothing
# about). Three websites is quantity 3 of the same product, which is why there
# are only two product ids no matter how far the ladder goes.
#
# `npm run verify:billing` asks Dodo whether these products charge what this
# build advertises. Run it after changing either.
DODO_API_KEY=
# From Developer → Webhooks. Point it at
#   https://api.<yourdomain>/api/billing/webhook
# and leave the event list empty to receive everything.
# Without this secret every webhook is REJECTED — and because Dodo hosts the
# payment page, the webhook is the ONLY thing that grants access, so a paying
# customer would silently stay on the free plan.
DODO_WEBHOOK_SECRET=
# The two product ids (pdt_xxxxxxxx) for one website.
DODO_PRODUCT_ID_MONTHLY=
DODO_PRODUCT_ID_YEARLY=
