# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=4000

# MongoDB Atlas connection string (the free M0 tier is plenty — content is text).
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/pagecraft

# Long random strings. Generate with: node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh

# How long a signed-in session lasts.
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# Where the dashboard is served from, for CORS. Comma-separated for several.
ADMIN_ORIGIN=http://localhost:3000

# Seed script: the first developer account created.
SEED_EMAIL=you@example.com
SEED_PASSWORD=change-me-now
SEED_NAME=Your Name

# Cloudinary — optional. Without these the CMS runs fine but photo uploads are
# disabled and the dashboard says so. Free tier: https://cloudinary.com
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=pagecraft
