# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=4000

# MongoDB Atlas connection string (the free M0 tier is plenty — content is text).
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/pagecraft

# Long random strings. Generate with: node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh

# How long a signed-in session lasts.
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# Where the dashboard is served from, for CORS. Comma-separated for several.
ADMIN_ORIGIN=http://localhost:3000

# Where the dashboard lives, used to build the links inside emails. Usually the
# same as ADMIN_ORIGIN, but only ever one address.
APP_URL=http://localhost:3000

# Email — required for people to sign up, because confirming an address is what
# makes an account usable. Without it the CMS still runs and everything else
# works; signing up refuses and says why, and outside production the link that
# would have been emailed is printed to this server's log instead.
#
# Any ordinary mailbox works. Zoho Mail's free plan on your own domain is the
# tidiest option; Gmail needs an App Password (not your normal password) and
# has low daily limits. Use port 465 with SMTP_SECURE=true, or 587 for STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
MAIL_FROM=Pagecraft <no-reply@yourdomain.com>

# Seed script: creates the platform administrator — you. This is the only
# account that skips email confirmation and the only one that can see across
# every user's websites. Everyone else signs up through the dashboard.
SEED_EMAIL=you@example.com
SEED_PASSWORD=change-me-now
SEED_NAME=Your Name

# Cloudflare R2 (media) — optional. Without these the CMS runs fine but photo
# uploads are disabled and the dashboard says so. R2 is S3-compatible: create a
# bucket + an R2 API token (Access Key ID + Secret), and attach a Custom Domain
# (cdn.<yourdomain>) fronted by Cloudflare Image Transformations for delivery.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# The R2 Custom Domain — NOT the un-cached r2.dev host.
R2_PUBLIC_BASE_URL=https://cdn.yourdomain.com
# Optional: HMAC secret for signed private-media URLs (validated by a CF Worker).
R2_URL_SIGNING_KEY=

# ---------------------------------------------------------------- Razorpay
# Payments. Optional in the same way R2 and SMTP are: without these the CMS
# runs, the billing screen explains what is missing, and nobody can create a
# website — which is the honest outcome, because the first one has to be paid
# for. There is no free trial.
#
# THE LADDER IS A QUANTITY, NOT A SET OF TIERS. Create ONE Razorpay Plan for
# "one website, monthly" at ₹999 and ONE for "one website, yearly" at ₹9,990.
# Three websites is quantity 3 of the same plan, which is why there are only
# two plan ids no matter how far the ladder goes — and why the price must stay
# strictly linear (Razorpay charges plan amount x quantity).
#
# `npm run setup:razorpay` creates both plans at the right amounts and prints
# the ids to paste below. Run it once with test keys and again with live keys —
# they are separate universes.
#
# Prices are in INR, Razorpay's home currency, which is what makes recurring
# mandates (UPI AutoPay, e-NACH, card mandates) work. Confirm the Subscriptions
# product is enabled on the account.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# From Settings → Webhooks. Subscribe the webhook to the subscription.* events
# and point it at  https://api.<yourdomain>/api/billing/webhook
# Without this secret every webhook is REJECTED rather than trusted — an
# unverified webhook is a public endpoint that hands out paid access.
RAZORPAY_WEBHOOK_SECRET=
# The two Plan ids (plan_xxxxxxxxxxxx) for one website.
RAZORPAY_PLAN_ID_MONTHLY=
RAZORPAY_PLAN_ID_YEARLY=
